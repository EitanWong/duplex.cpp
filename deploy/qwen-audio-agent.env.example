# Use the built-in minicpm-o Provider, NOT gpt-live or dashscope.
# Replace YOUR_LAN_IP and the API key; keep real credentials out of Git.
# Set this in the qwen application's voice frontend settings, not its Gateway
# connection or backend Agent settings. No server-side qwen WebUI is required.
QWEN_AUDIO_REALTIME_PROVIDER=minicpm-o
QWEN_AUDIO_REALTIME_URL=wss://YOUR_LAN_IP:8006/v1/realtime?mode=audio&model=MiniCPM-o-4.5-Realtime&protocol=qwen-audio-agent
QWEN_AUDIO_REALTIME_API_KEY=REPLACE_WITH_LOCAL_API_KEY
# MiniCPM-o's model and reference voice are managed by duplex.cpp.
QWEN_AUDIO_REALTIME_MODEL=
QWEN_AUDIO_REALTIME_VOICE=
AGENT_PROTOCOL=none
# Node reads this at process startup; use an absolute CA path on the qwen host.
NODE_EXTRA_CA_CERTS=/absolute/path/to/lan-ca.crt
